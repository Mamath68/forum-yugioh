{% extends 'base.html.twig' %}

{% block title %}Les Cartes{% endblock %}

{% block body %}
    <div class="row g-3 my-4">
        {% for card in cards %}
            {% set type = card.type %}

            {% set routeParams = {type: card.type} %}

            {% if card.type == "Spell Card" or card.type == "Trap Card" %}
                {% set type = card.race ~ " " ~ card.type %}
                {% set routeParams = routeParams|merge({race: card.race}) %}
            {% endif %}
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card h-100 my-3">
                    <div class="card-header text-center">
                        <a href="{{ path("app_card", {id: card.id}) }}" class="card-title h5 text-decoration-none">
                            {{ card.name }}
                        </a>
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <img src="{{ card.card_images[0].image_url }}" class="card-img img-fluid" alt="{{ card.name }}"
                             title="{{ card.name }}">
                    </div>
                    <div class="card-footer text-center">
                        <a class="text-decoration-none" href="{{ path('app_type', routeParams) }}">
                            <h2 class="h5">{{ type }}</h2>
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
