{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    {% set startPage = max(1, currentPage - 2) %}
    {% set endPage = min(totalPages, startPage + 4) %}

    {% if endPage - startPage < 4 %}
        {% set startPage = max(1, endPage - 4) %}
    {% endif %}

    <div class="row g-3 my-4">
        <h1>{{ title }}</h1>
        {% if totalPages > 1 %}
            <nav aria-label="Pagination des cartes">
                <ul class="pagination justify-content-center">

                    {# Page précédente #}
                    <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                        <a class="page-link"
                           href="{{ path('app_race', {
                               race: race,
                               page: currentPage - 1
                           }) }}">
                            Précédent
                        </a>
                    </li>

                    {# Numéros de page #}
                    {% for page in startPage..endPage %}
                        <li class="page-item {{ currentPage == page ? 'active' : '' }}">
                            <a class="page-link"
                               href="{{ path('app_race', {
                                   race: race,
                                   page: page
                               }) }}">
                                {{ page }}
                            </a>
                        </li>
                    {% endfor %}

                    {# Page suivante #}
                    <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                        <a class="page-link"
                           href="{{ path('app_race', {
                               race: race,
                               page: currentPage + 1
                           }) }}">
                            Suivant
                        </a>
                    </li>

                </ul>
            </nav>
        {% endif %}
        {% for card in cards %}
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card h-100 my-3">
                    <div class="card-header text-center">
                        <a href="{{ path("app_card", {id: card.id}) }}" class="card-title h5 text-decoration-none">
                            {{ card.name }}
                        </a>
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <img src="{{ card.card_images[0].image_url }}" class="card-img img-fluid" alt="{{ card.name }}"
                             title="{{ card.name }}">
                    </div>
                    <div class="card-footer text-center">
                        <a class="text-decoration-none" href="{{ path('app_type', {type: card.type}) }}">
                            <h2 class="h5">{{ card.type }}</h2>
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>


    {% if totalPages > 1 %}
        <nav aria-label="Pagination des cartes">
            <ul class="pagination justify-content-center">

                {# Page précédente #}
                <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                    <a class="page-link"
                       href="{{ path('app_race', {
                           race: race,
                           page: currentPage - 1
                       }) }}">
                        Précédent
                    </a>
                </li>

                {# Numéros de page #}
                {% for page in startPage..endPage %}
                    <li class="page-item {{ currentPage == page ? 'active' : '' }}">
                        <a class="page-link"
                           href="{{ path('app_race', {
                               race: race,
                               page: page
                           }) }}">
                            {{ page }}
                        </a>
                    </li>
                {% endfor %}

                {# Page suivante #}
                <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                    <a class="page-link"
                       href="{{ path('app_race', {
                           race: race,
                           page: currentPage + 1
                       }) }}">
                        Suivant
                    </a>
                </li>

            </ul>
        </nav>
    {% endif %}
{% endblock %}
