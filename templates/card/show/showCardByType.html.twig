{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <div class="row g-3 my-4">

        <h1>{{ title }}</h1>
        {% set startPage = max(1, currentPage - 2) %}
        {% set endPage = min(totalPages, startPage + 4) %}

        {% if endPage - startPage < 4 %}
            {% set startPage = max(1, endPage - 4) %}
        {% endif %}

        {% set paginationParams = {} %}

        {% set paginationParams = paginationParams|merge({type: type}) %}
        {% set paginationRoute = 'app_type' %}

        {% if race is defined and race is not null %}
            {% set paginationParams = paginationParams|merge({race: race}) %}
        {% endif %}

        {% if totalPages > 1 %}
            <nav aria-label="Pagination des cartes" class="my-4">
                <ul class="pagination justify-content-center">

                    <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                        <a class="page-link"
                           href="{{ path(paginationRoute, paginationParams|merge({page: currentPage - 1})) }}">
                            Précédent
                        </a>
                    </li>

                    {% for page in startPage..endPage %}
                        <li class="page-item {{ currentPage == page ? 'active' : '' }}">
                            <a class="page-link"
                               href="{{ path(paginationRoute, paginationParams|merge({page: page})) }}">
                                {{ page }}
                            </a>
                        </li>
                    {% endfor %}

                    <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                        <a class="page-link"
                           href="{{ path(paginationRoute, paginationParams|merge({page: currentPage + 1})) }}">
                            Suivant
                        </a>
                    </li>

                </ul>
            </nav>
        {% endif %}

        {% for card in cards %}

            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card h-100 my-3">

                    <div class="card-header text-center">
                        <a href="{{ path('app_card', {id: card.id}) }}"
                           class="card-title h5 text-decoration-none">
                            {{ card.name }}
                        </a>
                    </div>

                    <div class="card-body d-flex align-items-center justify-content-center">
                        <img src="{{ card.card_images[0].image_url }}"
                             class="card-img img-fluid"
                             alt="{{ card.name }}"
                             title="{{ card.name }}">
                    </div>
                </div>
            </div>
        {% endfor %}

    </div>

    {# Pagination en bas #}
    {% if totalPages > 1 %}
        <nav aria-label="Pagination des cartes" class="my-4">
            <ul class="pagination justify-content-center">

                <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                    <a class="page-link"
                       href="{{ path(paginationRoute, paginationParams|merge({page: currentPage - 1})) }}">
                        Précédent
                    </a>
                </li>

                {% for page in startPage..endPage %}
                    <li class="page-item {{ currentPage == page ? 'active' : '' }}">
                        <a class="page-link"
                           href="{{ path(paginationRoute, paginationParams|merge({page: page})) }}">
                            {{ page }}
                        </a>
                    </li>
                {% endfor %}

                <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                    <a class="page-link"
                       href="{{ path(paginationRoute, paginationParams|merge({page: currentPage + 1})) }}">
                        Suivant
                    </a>
                </li>

            </ul>
        </nav>
    {% endif %}

{% endblock %}
